{
  "name": "nexalliance-attendance-agent",
  "version": "1.0.0",
  "description": "NexAlliance Automatic Attendance Electron Desktop Agent",
  "author": "NexAlliance",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . NexAllianceAttendanceAgent --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --prune=true",
    "pack:mac": "electron-packager . NexAllianceAttendanceAgent --platform=darwin --arch=x64,arm64 --out=dist --overwrite --prune=true"
  },
  "dependencies": {
    "active-win": "^8.2.0",
    "auto-launch": "^5.0.6",
    "axios": "^1.7.2",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.2.1",
    "node-machine-id": "^1.1.12",
    "screenshot-desktop": "^1.15.4",
    "systeminformation": "^5.22.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-packager": "^17.1.2"
  }
}
